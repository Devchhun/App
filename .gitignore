node_modules/
out/
dist/
*.log
*.tsbuildinfo
.DS_Store

# Claude Code's own local session/settings state -- machine-specific, not project source.
.claude/

# Staged by scripts/fetch-portable-python.ps1 before a production build;
# regenerate rather than commit (hundreds of MB of native binaries).
resources/python-runtime/*
!resources/python-runtime/.gitkeep
# Demucs (htdemucs) separation weights -- shipped via electron-builder extraResources, never committed.
resources/demucs-models/*.th

# License signing private key -- never commit
admin-panel/signing-key.private.json
dist-admin/
admin-panel/.env
license-server/.env

# The license-issuing admin tool stays private (kept on this machine only).
admin-panel/
